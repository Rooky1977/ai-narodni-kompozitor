# Firebase (obavezno za Firestore)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Google Gemini (besplatni tier) — https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key

# Opcionalno — Hugging Face (besplatni token) za MusicGen isječke
# https://huggingface.co/settings/tokens
# VITE_HF_TOKEN=hf_xxxxxxxx

# Opcionalno — Suno (nema zvanični free public API):
# 1) Self-host gcui-art/suno-api pa stavi bazni URL:
# VITE_SUNO_API_URL=https://your-suno-wrapper.vercel.app
# 2) Ili custom music omotač:
# VITE_MUSIC_API_URL=https://your-music-api.example.com/generate
# 3) Ili sunoapi.org ključ (plaćeni/trial):
# VITE_SUNO_API_KEY=your_suno_api_key
#
# Bez ovoga: Pro Studio (Tone/Magenta) radi 100% besplatno u browseru;
# Suno web + MP3 fallback ostaje dostupan.
